<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.jailscale</groupId>
  <artifactId>jailscale-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>jailscale</name>
  <description>A self-hosted tunnel in Java: SNI-passthrough hub, node-terminated TLS with hub-side signing, wildcard ACME via built-in DNS-01, invite-based membership (no IdP)</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>crypto</module>
    <module>proto</module>
    <module>node</module>
    <module>hub</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Versions verified against Maven Central on 2026-09-10 (ARCHITECTURE.md §3.2). -->
    <junit.version>6.1.3</junit.version>
    <native-maven-plugin.version>1.1.12</native-maven-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>

    <spotbugs-maven-plugin.version>4.9.8.5</spotbugs-maven-plugin.version>

    <!-- Modules that produce a native binary override these (see node, hub). -->
    <native.skip>true</native.skip>
    <native.imageName>${project.artifactId}</native.imageName>
    <native.mainClass/>
    <!--
      A heap ceiling, per binary (§14). Without one the Serial GC's allowance is
      -XX:MaximumHeapSizePercent=80, so a long-running hub drifts up to 80% of the machine: the
      live hub reached 53.9 MB of anonymous memory after 20 idle hours on a 969 MB instance, and
      capping it is what stops that. Measured with LOAD=1000 ./measure.sh on linux-amd64, peak RSS
      with 1,000 visitors held open: uncapped 91.7 (hub) and 94.0 (node), 128m 74.2/84.6,
      96m 64.9/72.0, 64m 54.8/61.5, every arm holding all 1,000 and passing the gate. Idle RSS and
      CLI start do not move; the ramp is 2.5s uncapped against 2.7s at 64m.

      Both binaries accept -XX:MaxHeapSize= at run time (the native runtime takes it before main
      sees it, so it does not collide with the CLI's own parsing), but only the hub is raised that
      way in practice, on the unit's ExecStart. The node's daemon takes them from
      JAILSCALE_DAEMON_OPTS, which Service.daemonCommand puts straight after the executable whether
      the CLI spawns the daemon or `service install` writes a unit for it.
    -->
    <native.maxHeap>64m</native.maxHeap>
    <!--
      Extra native-image arguments, empty unless a profile below sets them. Two exist: `pgo` builds
      with the profiles committed under profiles/, and `pgo-instrument` builds the instrumented
      binaries that produce one. Both need Oracle GraalVM, which is what the release builds on;
      neither is on by default, so `./native.sh` with a Community Edition keg still works and
      building from source still needs nothing but a GraalVM (§3.1).
    -->
    <native.extraArg>-H:+ReportExceptionStackTraces</native.extraArg>
    <test.excludedGroups>load</test.excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.jailscale</groupId>
        <artifactId>crypto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jailscale</groupId>
        <artifactId>proto</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- Load tests (ARCHITECTURE.md §14) run on demand: -Dgroups=load -Dtest.excludedGroups=
                 (the property below, not surefire's own -DexcludedGroups, which this overrides) -->
            <excludedGroups>${test.excludedGroups}</excludedGroups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <archive>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>${native-maven-plugin.version}</version>
          <extensions>true</extensions>
          <configuration>
            <skip>${native.skip}</skip>
            <imageName>${native.imageName}</imageName>
            <mainClass>${native.mainClass}</mainClass>
            <!-- No third-party dependencies, no reflection (ARCHITECTURE.md §3.1): nothing to fetch. -->
            <metadataRepository>
              <enabled>false</enabled>
            </metadataRepository>
            <buildArgs>
              <buildArg>-O2</buildArg>
              <buildArg>-R:MaxHeapSize=${native.maxHeap}</buildArg>
              <buildArg>${native.extraArg}</buildArg>
            </buildArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      ./mvnw -Pnative,pgo package

      Builds with the profile committed for this binary (§14). Measured: every PGO build comes out
      about 7 MiB smaller with a fifth less idle RSS, on either platform, and the CPU gain is
      between nothing and half depending on the profile, which is why the profile in the repository
      is merged from three runs rather than taken from one. Needs Oracle GraalVM: PGO is not in the
      Community Edition.
    -->
    <profile>
      <id>pgo</id>
      <properties>
        <native.extraArg>-H:+ReportExceptionStackTraces --pgo=${maven.multiModuleProjectDirectory}/profiles/${project.artifactId}.iprof -Djailscale.pgo=true</native.extraArg>
      </properties>
    </profile>

    <!--
      ./mvnw -Pnative,pgo-instrument package

      The other half: binaries that record what they do. Run one under a workload that covers the
      kinds of work you care about (a profile collected without visitors arriving gave no
      handshake gain at all), and point it somewhere with
      HUB_OPTS=-XX:ProfilesDumpFile=... or JAILSCALE_DAEMON_OPTS=-XX:ProfilesDumpFile=...
    -->
    <profile>
      <id>pgo-instrument</id>
      <properties>
        <native.extraArg>-H:+ReportExceptionStackTraces --pgo-instrument</native.extraArg>
      </properties>
    </profile>

    <!--
      ./mvnw -Panalyze verify

      Static analysis, and deliberately not part of `package`. -Xlint:all -Werror is what every
      build runs and what every contributor has to satisfy; it is a compiler already on the
      machine and costs nothing to keep. SpotBugs is a third-party tool with a dependency tree of
      its own, and §3.2's argument about supply-chain surface does not stop at runtime
      dependencies, so building jailscale from source must not need it. CI runs this as a job of
      its own, where the jars it fetches never touch a released binary.

      It reads bytecode, so it sees what -Xlint cannot: a stream that is never closed, a field
      written by one thread and read by another without synchronisation, an ignored return value.
      That is the class of defect this project's threading makes easy to write and hard to spot.
    -->
    <profile>
      <id>analyze</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>${spotbugs-maven-plugin.version}</version>
            <configuration>
              <effort>Max</effort>
              <threshold>Medium</threshold>
              <includeTests>false</includeTests>
              <excludeFilterFile>${session.executionRootDirectory}/spotbugs-exclude.xml</excludeFilterFile>
            </configuration>
            <executions>
              <execution>
                <id>spotbugs-check</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      ./mvnw -Pnative package
      Requires GraalVM for JDK 25 with native-image on PATH (brew install graalvm).
      Only modules that set native.skip=false (node, hub) produce a binary.
    -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
