<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jailscale</groupId>
    <artifactId>jailscale-parent</artifactId>
    <version>0.1.3-SNAPSHOT</version>
  </parent>
  <artifactId>node</artifactId>
  <name>node</name>
  <description>Node daemon and CLI: local IPC, TLS termination with remote signing, relay, visitor gate</description>

  <properties>
    <native.skip>false</native.skip>
    <native.imageName>jailscale</native.imageName>
    <native.mainClass>io.jailscale.node.Main</native.mainClass>
    <!-- Same as the parent's fallback, said here on purpose: a binary's heap ceiling should be
         readable in its own pom rather than inherited from a default that happens to match. -->
    <native.maxHeap>64m</native.maxHeap>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.jailscale</groupId>
      <artifactId>proto</artifactId>
    </dependency>
    <!-- TestPorts, so the tests here hand out ports the way proto's do (jailscale#108). -->
    <dependency>
      <groupId>io.jailscale</groupId>
      <artifactId>proto</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              <mainClass>io.jailscale.node.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <!-- Fallback JAR for platforms without a native binary (ARCHITECTURE.md §1, §14): java -jar target/jailscale.jar -->
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/jailscale.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.jailscale.node.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
