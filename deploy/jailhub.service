# systemd unit for jailhub (ARCHITECTURE.md §7.2, §13).
#   install -m 0755 jailhub /usr/local/bin/jailhub
#   useradd --system --home /var/lib/jailhub --create-home --shell /usr/sbin/nologin jailhub
#   install -m 0644 jailhub.service /etc/systemd/system/
#   systemctl enable --now jailhub
#
# Updating: replace the binary and `systemctl restart jailhub`. Nodes reconnect on their own and
# the hub is back inside a few seconds.
#
# A standby (ARCHITECTURE.md §13.1) is this same unit on a second host with the primary's hub.key
# copied into /var/lib/jailhub and `--peer https://hub.example.com` added to ExecStart; the base URL
# stays the primary's name, since that is the name the standby will serve once promoted. It has no
# nodes to relay challenges for and issues no certificate, so its port 80 is unused until
# `jailhub promote`; port 53 it serves from the start, as the second name server of the subdomain
# (ARCHITECTURE.md §13.3), so open UDP/TCP 53 on both hosts and delegate the subdomain to both.
#
# Not `systemctl reload`, and there is deliberately no ExecReload here. `serve --takeover` works by
# starting a second process that takes the listeners and lets the first exit. Under a unit that
# first process is the one systemd tracks, so its exit stops the unit and takes the new process
# down with the cgroup. Tried it: the hub went inactive. The hand-off is for operators who run
# jailhub outside a unit.
#
# Type=simple, so `systemctl start` returns when the process exists, not when it is serving; on a
# first boot those are minutes of ACME apart, and the status page is what says which. A Type=notify
# hub was tried and removed (#250): it needed TimeoutStartSec=infinity to survive its own first
# issuance, NotifyAccess=all because the JDK cannot open the datagram socket, and systemd 246, and
# this unit never asked for it. A unit of your own that says Type=notify has to go back to
# Type=simple before this release: the hub no longer sends the message, so under Type=notify the
# unit would stay `activating` forever, or be killed at TimeoutStartSec.

[Unit]
Description=jailhub — jailscale hub (SNI router, control channel, ACME)
Documentation=https://github.com/eth219/jailscale
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jailhub
Group=jailhub
Environment=JAILHUB_STATE=/var/lib/jailhub
# Edit: your public name, and an e-mail for Let's Encrypt expiry notices.
# There is no metrics port (ARCHITECTURE.md 6.3). What an operator watches -- visitors routed and
# refused, the receive budget -- is on the admin socket: `jailhub status`, as this unit's user.
ExecStart=/usr/local/bin/jailhub serve --base-url https://hub.example.com --acme-email ops@example.com
Restart=on-failure
RestartSec=2s
# A clean SIGTERM shutdown exits 143. Without this, every `systemctl restart` logs
# "Failed with result 'exit-code'" for a shutdown that worked, which is the only warning in an
# otherwise clean journal and trains an operator to ignore the ones that matter.
SuccessExitStatus=143
# jailhub binds 443, 80 and 53 as a non-root user:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jailhub
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
