# systemd unit for jailhub (ARCHITECTURE.md §7.2, §13).
#   install -m 0755 jailhub /usr/local/bin/jailhub
#   useradd --system --home /var/lib/jailhub --create-home --shell /usr/sbin/nologin jailhub
#   install -m 0644 jailhub.service /etc/systemd/system/
#   systemctl enable --now jailhub
#
# Updating: replace the binary and `systemctl restart jailhub`. Nodes reconnect on their own and
# the hub is back inside a few seconds.
#
# Not `systemctl reload`, and there is deliberately no ExecReload here. `serve --takeover` works by
# starting a second process that takes the listeners and lets the first exit. Under a unit that
# first process is the one systemd tracks, so its exit stops the unit and takes the new process
# down with the cgroup. Tried it: the hub went inactive. The hand-off is for operators who run
# jailhub outside a unit; the readiness reporting below does not change that, it only moves when
# systemd calls the unit started.
#
# Readiness reporting is available and is deliberately not turned on here. jailhub can tell systemd
# when it is actually serving, so that `systemctl start` returns then rather than as soon as the
# process exists -- on a first boot those are minutes of ACME apart. Turning it on is three lines:
#
#   Type=notify
#   NotifyAccess=all
#   TimeoutStartSec=infinity
#
# All three, or it is worse than not doing it. jailhub does not return from startup until it has a
# certificate, and issuance retries for as long as that takes: one failed self-check is 60s and one
# validation is up to 120s, so an ordinary first boot is already past systemd's 90s default
# TimeoutStartSec. Without `infinity` systemd kills the hub part-way through getting its first
# certificate, and Restart=on-failure below does it again, forever.
#
# NotifyAccess=all is needed because the notification comes from a child process: NOTIFY_SOCKET is
# an AF_UNIX datagram socket and the JDK will not open one, so jailhub runs systemd-notify. On a
# host without systemd-notify the unit stays in `activating` although the hub is serving normally.
#
# And it needs systemd 246 or newer. A notification from a child that has already exited is one the
# manager cannot attribute to a unit, so it drops it even with NotifyAccess=all; systemd-notify
# avoids that by waiting for the message to be processed, which arrived in 246 along with the
# --no-block switch that turns it off. Older systemd does not wait, so the readiness message is
# lost: Ubuntu 20.04 has 245, Debian 10 has 241, RHEL 8 has 239. Combined with
# TimeoutStartSec=infinity that is a `systemctl start` which never returns, so check
# `systemctl --version` before turning any of this on.

[Unit]
Description=jailhub — jailscale hub (SNI router, control channel, ACME)
Documentation=https://github.com/eth219/jailscale
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jailhub
Group=jailhub
Environment=JAILHUB_STATE=/var/lib/jailhub
# Edit: your public name, and an e-mail for Let's Encrypt expiry notices.
# /metrics is on 127.0.0.1:9090 by default and never on the public name (ARCHITECTURE.md 6.3), so a
# Prometheus on this host scrapes it as-is and one elsewhere comes in over a tunnel. Widen it with
# --metrics-listen <addr>:9090 only behind a firewall: that port asks nobody who they are.
ExecStart=/usr/local/bin/jailhub serve --base-url https://hub.example.com --acme-email ops@example.com
Restart=on-failure
RestartSec=2s
# A clean SIGTERM shutdown exits 143. Without this, every `systemctl restart` logs
# "Failed with result 'exit-code'" for a shutdown that worked, which is the only warning in an
# otherwise clean journal and trains an operator to ignore the ones that matter.
SuccessExitStatus=143
# jailhub binds 443, 80 and 53 as a non-root user:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jailhub
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
